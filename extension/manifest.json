{
  "manifest_version": 3,
  "name": "Custom New Tab (auto-updating)",
  "version": "1.0.0",
  "description": "Shows your Custom New Tab Dashboard from GitHub on every new tab, keeping the cursor in the address bar. Install once; the dashboard updates itself from GitHub.",
  "key": "",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
